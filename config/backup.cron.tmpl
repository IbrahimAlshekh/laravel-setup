# Run daily at 02:30 as root.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

30 2 * * *  root  bash ${SCRIPT_DIR}/lib/backup.sh >> /var/log/${APP_NAME}-backup.log 2>&1
