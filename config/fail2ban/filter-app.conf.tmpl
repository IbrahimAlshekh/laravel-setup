# =============================================================================
# Fail2ban filter for Laravel admin brute-force — rendered by setup.sh
# Variables: ${APP_NAME}
# Placed at /etc/fail2ban/filter.d/${APP_NAME}-admin.conf
# =============================================================================
[Definition]

# Match POST requests to login endpoints returning 401, 403, or 422.
# Matches Nginx combined log format:
#   <IP> - - [date] "POST /path HTTP/x.y" STATUS_CODE bytes referrer agent
failregex = ^<HOST> .+ "POST /(admin/login|login|ar/login|en/login) HTTP/\d\.\d" (401|403|422) .+$
            ^<HOST> .+ "POST /admin HTTP/\d\.\d" (401|403|422) .+$

ignoreregex =

datepattern = %%d/%%b/%%Y:%%H:%%M:%%S %%z
