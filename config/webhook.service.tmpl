# =============================================================================
# Systemd unit for the webhook listener — rendered by setup.sh via envsubst
# Variables: ${APP_NAME} ${APP_USER} ${SCRIPT_DIR}
# Placed at /etc/systemd/system/webhook-${APP_NAME}.service
# =============================================================================

[Unit]
Description=Webhook listener for ${APP_NAME} deploy
After=network.target
Wants=network.target

[Service]
Type=simple
User=${APP_USER}
Group=www-data
ExecStart=/usr/bin/webhook \
    -hooks /etc/webhook/${APP_NAME}-hooks.json \
    -ip 127.0.0.1 \
    -port 9000 \
    -verbose
Restart=on-failure
RestartSec=5

# Restrict capabilities to the minimum
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=${APP_DIR}/storage/logs

[Install]
WantedBy=multi-user.target
