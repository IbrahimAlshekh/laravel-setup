# =============================================================================
# Sudoers drop-in for the deploy user — rendered by setup.sh via envsubst
# Variables: ${APP_USER} ${APP_NAME} ${PHP_VERSION}
# Placed at /etc/sudoers.d/${APP_USER} by setup.sh (mode 440)
#
# Grants the deploy user ONLY the minimum privileges needed to deploy:
#   • restart php-fpm   (picks up new code + clears OPcache)
#   • reload nginx      (in case config was updated)
#   • restart supervisor group  (restart queue workers)
# Everything else requires a root shell.
# =============================================================================

Defaults:${APP_USER} !requiretty

${APP_USER} ALL=(root) NOPASSWD: \
    /bin/systemctl restart php${PHP_VERSION}-fpm, \
    /bin/systemctl reload  nginx, \
    /bin/systemctl reload  php${PHP_VERSION}-fpm, \
    /usr/bin/supervisorctl restart ${APP_NAME}:*, \
    /usr/bin/supervisorctl reread, \
    /usr/bin/supervisorctl update
