# =============================================================================
# .env.deploy.example — User-provided deployment configuration
#
# Copy this file to .env.deploy and fill in your values:
#   cp .env.deploy.example .env.deploy
#   $EDITOR .env.deploy
#
# This file is for the DEPLOYMENT TOOLING only — it has nothing to do with
# your Laravel application's .env (which is generated automatically).
#
# These are the ONLY 9 values you need to provide.
# All secrets (DB password, Redis password, APP_KEY, etc.) are generated
# automatically and stored in /etc/<app-name>/secrets.env (mode 600, root).
# =============================================================================

# Domain name — no www, no protocol
export DOMAIN=example.com

# Email used for Let's Encrypt TLS certificate notifications
export CERTBOT_EMAIL=admin@example.com

# Git repository SSH URL (the server will generate and print a deploy key)
export REPO_URL=git@github.com:your-org/your-repo.git

# Branch to deploy
export REPO_BRANCH=main

# Absolute path where the application will live on the server
export APP_DIR=/var/www/myapp

# Directory where backups are stored (created automatically, mode 700)
export BACKUP_DIR=/var/backups/myapp

# How many daily backup sets to retain (pre-deploy + daily cron)
export KEEP_BACKUPS=7

# PHP version to install (e.g. 8.3, 8.4)
export PHP_VERSION=8.4

# Set to "true" to install a webhook listener for automatic deploy-on-push.
# When true, setup.sh will print the GitHub webhook URL and HMAC secret.
# When false, deploy manually: sudo bash deploy.sh
export DEPLOY_ON_PUSH=false
