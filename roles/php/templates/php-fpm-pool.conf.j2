; =============================================================================
; PHP-FPM pool for {{ app_name }}
; Managed by Ansible — do not edit manually.
; =============================================================================

[{{ app_name }}]
user  = {{ app_user }}
group = www-data

; Unix socket — faster than TCP for local connections.
listen       = /run/php/php{{ php_version }}-fpm-{{ app_name }}.sock
listen.owner = {{ app_user }}
listen.group = www-data
listen.mode  = 0660

; Dynamic process management.
pm                   = dynamic
pm.max_children      = 20
pm.start_servers     = 4
pm.min_spare_servers = 2
pm.max_spare_servers = 6
pm.max_requests      = 500

; Timeouts.
request_terminate_timeout = 300
request_slowlog_timeout   = 10s
slowlog = /var/log/php/{{ app_name }}-slow.log

; Security: restrict filesystem access to only what PHP needs.
php_admin_value[open_basedir]      = {{ app_dir }}:/tmp:/var/lib/php/sessions
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,curl_multi_exec,parse_ini_file,show_source,pcntl_exec

; Logging.
php_admin_value[error_log]       = /var/log/php/{{ app_name }}-fpm-error.log
php_admin_flag[log_errors]       = on
php_flag[display_errors]         = off
php_flag[display_startup_errors] = off

; Upload limits.
php_value[upload_max_filesize] = 20M
php_value[post_max_size]       = 20M
php_value[max_execution_time]  = 300
php_value[memory_limit]        = 256M

; Sessions are managed by Laravel via Valkey.
clear_env = no

; FPM status page (restricted to localhost in Nginx).
pm.status_path = /fpm-status
