# =============================================================================
# Valkey app config — managed by Ansible, do not edit manually.
# Included at end of /etc/valkey/valkey.conf so these settings override defaults.
# =============================================================================

# Bind only to localhost — never expose Valkey to the network.
bind 127.0.0.1 -::1
protected-mode yes
port 6379

# Authentication
requirepass {{ redis_pass }}

# Memory management
maxmemory 256mb
maxmemory-policy allkeys-lru

# Persistence (AOF for durability, RDB for fast restarts)
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# Disable dangerous commands to limit blast radius from a compromised app.
rename-command FLUSHALL   ""
rename-command FLUSHDB    ""
rename-command CONFIG     ""
rename-command DEBUG      ""
rename-command SHUTDOWN   ""
rename-command SLAVEOF    ""
rename-command REPLICAOF  ""

# Supervised by systemd
supervised systemd
